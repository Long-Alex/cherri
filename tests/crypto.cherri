@input = "hello"

// SHA256 is deterministic for a known input
const sha256 = hash(@input, "SHA256")
if sha256 != "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824" {
    mustOutput("❌ FAIL: hash SHA256 — got {sha256}", "❌ FAIL: hash SHA256 — got {sha256}")
}

// SHA1 of "hello"
const sha1 = hash(@input, "SHA1")
if sha1 != "aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d" {
    mustOutput("❌ FAIL: hash SHA1 — got {sha1}", "❌ FAIL: hash SHA1 — got {sha1}")
}

// base64 encode
const encoded = base64Encode(@input)
if encoded != "aGVsbG8=" {
    mustOutput("❌ FAIL: base64Encode — got {encoded}, expected 'aGVsbG8='", "❌ FAIL: base64Encode — got {encoded}, expected 'aGVsbG8='")
}

// base64 decode round-trip
@b64 = "aGVsbG8="
const decoded = base64Decode(@b64)
const decodedStr = "{decoded}"
if decodedStr != "hello" {
    mustOutput("❌ FAIL: base64Decode — got {decoded}, expected 'hello'", "❌ FAIL: base64Decode — got {decoded}, expected 'hello'")
}

// base64 of text longer than 76 chars must contain no line breaks
// (GitHub contents API rejects base64 broken by line wrapping)
@longText = "The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog."
const longEncoded = base64Encode(@longText)
if longEncoded != "VGhlIHF1aWNrIGJyb3duIGZveCBqdW1wcyBvdmVyIHRoZSBsYXp5IGRvZy4gVGhlIHF1aWNrIGJyb3duIGZveCBqdW1wcyBvdmVyIHRoZSBsYXp5IGRvZy4gVGhlIHF1aWNrIGJyb3duIGZveCBqdW1wcyBvdmVyIHRoZSBsYXp5IGRvZy4g" {
    mustOutput("❌ FAIL: base64Encode long text — got {longEncoded}", "❌ FAIL: base64Encode long text — got {longEncoded}")
}

// SHA512 and MD5: compile-only coverage (MD5 is hash default)
const sha512 = hash(@input, "SHA512")
const md5 = hash(@input)

show("✅ All tests passed")
